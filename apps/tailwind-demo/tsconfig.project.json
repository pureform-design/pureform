{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "types": ["vite/client"],
        "jsx": "preserve",
        "jsxImportSource": "@solidjs/web",
        "noEmit": true
    },
    // `.pureform/` holds the registry and the declarations that type it; TypeScript's globs skip
    // dot folders unless named.
    "include": ["src", ".pureform/**/*.*"]
}
