{
  "extends": ["@pureform/tsconfig/base.json"],
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "$*": ["./styled-system/*"],
      "#*": ["./src/*"]
    }
  },
  // The base config includes `src` only; `.pureform/` holds the registry and the
  // declarations that type it, and `vitest-e2e-context.d.ts` what the smoke test injects.
  "include": ["src/**/*.*", ".pureform/**/*.*", "vitest-e2e-context.d.ts"]
}
