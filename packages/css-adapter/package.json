{
    "name": "@pureform/css-adapter",
    "version": "0.0.0-semantically-released",
    "description": "Compiles a pureform CoreConfig to plain CSS and a class name runtime",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            }
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": {
                "development": "./src/runtime.ts",
                "default": "./dist/runtime.mjs"
            },
            "require": {
                "development": "./src/runtime.ts",
                "default": "./dist/runtime.mjs"
            }
        }
    },
    "dependencies": {
        "@pureform/core": "catalog:",
        "@pureform/css-lowering": "catalog:"
    },
    "devDependencies": {
        "@pureform/material": "catalog:",
        "@pureform/preset": "catalog:",
        "@pureform/tsconfig": "catalog:",
        "@pureform/vite-config": "catalog:",
        "@pureform/vitest-config": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
