{
    "name": "@pureform/css-adapter",
    "version": "0.0.0-semantically-released",
    "description": "Compiles a pureform CoreConfig to plain CSS and a class name runtime",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            }
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": {
                "development": "./src/runtime.ts",
                "default": "./dist/runtime.mjs"
            },
            "require": {
                "development": "./src/runtime.ts",
                "default": "./dist/runtime.mjs"
            }
        },
        "./codegen": {
            "types": "./dist/codegen.d.ts",
            "import": {
                "development": "./src/codegen.ts",
                "default": "./dist/codegen.mjs"
            },
            "require": {
                "development": "./src/codegen.ts",
                "default": "./dist/codegen.mjs"
            }
        },
        "./reset.css": "./reset.css"
    },
    "dependencies": {
        "@pureform/core": "workspace:^",
        "@pureform/css-lowering": "workspace:^",
        "@pureform/generate": "workspace:^",
        "@pureform/styling": "workspace:^"
    },
    "devDependencies": {
        "@pureform/material": "workspace:^",
        "@pureform/preset": "workspace:^",
        "@pureform/tsconfig": "workspace:^",
        "@pureform/vite-config": "workspace:^",
        "@pureform/vitest-config": "workspace:^",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
