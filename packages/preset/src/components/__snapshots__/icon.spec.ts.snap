exports[`icon > compiles to a stable Panda recipe 1`] = `
{
  "base": {},
  "className": "icon",
  "compoundVariants": [],
  "defaultVariants": {
    "color": "current",
    "filled": "inherit",
    "size": "medium",
  },
  "jsx": [
    "Icon",
  ],
  "variants": {
    "color": {
      "current": {},
      "error": {
        "color": "token(colors.error)",
      },
      "info": {
        "color": "token(colors.info)",
      },
      "primary": {
        "color": "token(colors.primary)",
      },
      "secondary": {
        "color": "token(colors.secondary)",
      },
      "success": {
        "color": "token(colors.success)",
      },
      "tertiary": {
        "color": "token(colors.tertiary)",
      },
      "warning": {
        "color": "token(colors.warning)",
      },
    },
    "filled": {
      "false": {
        "fontVariationSettings": ""FILL" 0",
      },
      "inherit": {},
      "true": {
        "fontVariationSettings": ""FILL" 1",
      },
    },
    "size": {
      "large": {
        "_rtl": {
          "&[data-pf-mirror]": {
            "transform": "scaleX(-1)",
          },
        },
        "alignItems": "center",
        "display": "inline-flex",
        "fontSize": "var(--components-icon-sizeLarge, 36px)",
        "height": "var(--components-icon-sizeLarge, 36px)",
        "justifyContent": "center",
        "lineHeight": "1",
        "minWidth": "var(--components-icon-sizeLarge, 36px)",
        "width": "var(--components-icon-sizeLarge, 36px)",
      },
      "medium": {
        "_rtl": {
          "&[data-pf-mirror]": {
            "transform": "scaleX(-1)",
          },
        },
        "alignItems": "center",
        "display": "inline-flex",
        "fontSize": "var(--components-icon-sizeMedium, token(sizes.iconMedium))",
        "height": "var(--components-icon-sizeMedium, token(sizes.iconMedium))",
        "justifyContent": "center",
        "lineHeight": "1",
        "minWidth": "var(--components-icon-sizeMedium, token(sizes.iconMedium))",
        "width": "var(--components-icon-sizeMedium, token(sizes.iconMedium))",
      },
      "small": {
        "_rtl": {
          "&[data-pf-mirror]": {
            "transform": "scaleX(-1)",
          },
        },
        "alignItems": "center",
        "display": "inline-flex",
        "fontSize": "var(--components-icon-sizeSmall, token(sizes.iconSmall))",
        "height": "var(--components-icon-sizeSmall, token(sizes.iconSmall))",
        "justifyContent": "center",
        "lineHeight": "1",
        "minWidth": "var(--components-icon-sizeSmall, token(sizes.iconSmall))",
