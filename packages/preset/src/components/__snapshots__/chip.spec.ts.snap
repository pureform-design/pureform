              "&[data-dragging][data-dragging]": "color-mix(in srgb, var(--components-chip-selectedContainer, token(colors.secondaryContainer)), var(--components-chip-selectedContent, token(colors.onSecondaryContainer)) token(opacity.stateDragged))",
              "_active": "color-mix(in srgb, var(--components-chip-selectedContainer, token(colors.secondaryContainer)), var(--components-chip-selectedContent, token(colors.onSecondaryContainer)) token(opacity.statePressed))",
              "_focusVisible": "color-mix(in srgb, var(--components-chip-selectedContainer, token(colors.secondaryContainer)), var(--components-chip-selectedContent, token(colors.onSecondaryContainer)) token(opacity.stateFocus))",
              "_hover": "color-mix(in srgb, var(--components-chip-selectedContainer, token(colors.secondaryContainer)), var(--components-chip-selectedContent, token(colors.onSecondaryContainer)) token(opacity.stateHover))",
              "base": "var(--components-chip-selectedContainer, token(colors.secondaryContainer))",
            },
            "borderColor": "transparent",
            "color": "var(--components-chip-selectedContent, token(colors.onSecondaryContainer))",
          },
          "_disabled": {
            "backgroundColor": "transparent",
            "borderColor": "color-mix(in srgb, transparent, token(colors.onSurface) token(opacity.disabledContainer))",
            "color": "color-mix(in srgb, transparent, token(colors.onSurface) token(opacity.disabledContent))",
          },
          "backgroundColor": {
            "&[data-dragging][data-dragging]": "color-mix(in srgb, var(--components-chip-container, transparent), var(--components-chip-content, token(colors.onSurfaceVariant)) token(opacity.stateDragged))",
            "_active": "color-mix(in srgb, var(--components-chip-container, transparent), var(--components-chip-content, token(colors.onSurfaceVariant)) token(opacity.statePressed))",
            "_focusVisible": "color-mix(in srgb, var(--components-chip-container, transparent), var(--components-chip-content, token(colors.onSurfaceVariant)) token(opacity.stateFocus))",
            "_hover": "color-mix(in srgb, var(--components-chip-container, transparent), var(--components-chip-content, token(colors.onSurfaceVariant)) token(opacity.stateHover))",
            "base": "var(--components-chip-container, transparent)",
          },
          "borderColor": "var(--components-chip-outlineColor, token(colors.outlineVariant))",
          "borderStyle": "solid",
          "borderWidth": "var(--components-chip-outlineWidth, 1px)",
          "color": "var(--components-chip-content, token(colors.onSurfaceVariant))",
        },
      },
    },
  },
}
`;
