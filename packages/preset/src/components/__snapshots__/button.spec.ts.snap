            "&[data-pf-dragging][data-pf-dragging]": "color-mix(in srgb, var(--components-button-accentContainer, token(colors.primaryContainer)), var(--components-button-onAccentContainer, token(colors.onPrimaryContainer)) var(--components-button-indication-stateDraggedOpacity, var(--components-button-stateDraggedOpacity, token(opacity.stateDragged))))",
            "base": "var(--components-button-accentContainer, token(colors.primaryContainer))",
