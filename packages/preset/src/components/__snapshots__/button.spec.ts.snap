            "&:is(:active, [data-pf-active])": "color-mix(in srgb, transparent, var(--components-button-accent, token(colors.primary)) var(--components-button-indication-statePressedOpacity, var(--components-button-statePressedOpacity, token(opacity.statePressed))))",
            "&:is(:hover, [data-pf-hover])": "color-mix(in srgb, transparent, var(--components-button-accent, token(colors.primary)) var(--components-button-indication-stateHoverOpacity, var(--components-button-stateHoverOpacity, token(opacity.stateHover))))",
            "&[data-pf-dragging][data-pf-dragging]": "color-mix(in srgb, transparent, var(--components-button-accent, token(colors.primary)) var(--components-button-indication-stateDraggedOpacity, var(--components-button-stateDraggedOpacity, token(opacity.stateDragged))))",
