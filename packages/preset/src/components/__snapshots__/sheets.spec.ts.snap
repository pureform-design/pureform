exports[`bottomSheet > compiles to a stable Panda slot recipe 1`] = `
{
  "base": {
    "content": {
      "color": "var(--components-bottomSheet-content, token(colors.onSurfaceVariant))",
      "flexGrow": "1",
      "minHeight": "0px",
      "overflow": "auto",
      "paddingBlockEnd": "var(--components-bottomSheet-contentPaddingEnd, token(spacing.6))",
      "paddingInlineEnd": "var(--components-bottomSheet-contentPadding, token(spacing.4))",
      "paddingInlineStart": "var(--components-bottomSheet-contentPadding, token(spacing.4))",
      "textStyle": "bodyMedium",
    },
    "dragHandle": {
      "marginInlineEnd": "auto",
      "marginInlineStart": "auto",
    },
    "root": {
      "&[data-state=closed]": {
        "animation": {
          "_motionReduce": "token(durations.medium1) token(easings.emphasizedAccelerate) forwards overlayFadeOut",
          "base": "token(durations.medium1) token(easings.emphasizedAccelerate) forwards bottomSheetOut",
        },
      },
      "&[data-state=open]": {
        "animation": {
          "_motionReduce": "token(durations.long2) token(easings.emphasizedDecelerate) overlayFadeIn",
          "base": "token(durations.long2) token(easings.emphasizedDecelerate) bottomSheetIn",
        },
      },
      "backgroundColor": "var(--components-bottomSheet-container, token(colors.surfaceContainerLow))",
      "borderEndEndRadius": "0px",
      "borderEndStartRadius": "0px",
      "borderStartEndRadius": "var(--components-bottomSheet-radius, token(radii.extraLarge))",
      "borderStartStartRadius": "var(--components-bottomSheet-radius, token(radii.extraLarge))",
      "borderWidth": "0px",
      "color": "var(--components-bottomSheet-content, token(colors.onSurfaceVariant))",
      "display": "flex",
      "flexDirection": "column",
      "marginInlineEnd": "auto",
      "marginInlineStart": "auto",
      "maxHeight": "100%",
      "maxWidth": "var(--components-bottomSheet-maxWidth, 640px)",
      "minHeight": "0px",
      "shadowElevation": "level1",
      "width": "100%",
    },
  },
  "className": "bottomSheet",
  "compoundVariants": [],
  "defaultVariants": {
    "modal": true,
  },
  "jsx": [
    "BottomSheet",
  ],
  "slots": [
    "root",
    "dragHandle",
    "content",
  ],
  "variants": {
    "modal": {
      "false": {
        "root": {
          "zIndex": "token(zIndex.raised)",
        },
      },
      "true": {
        "root": {
          "zIndex": "token(zIndex.dialog)",
        },
      },
    },
  },
}
`;

