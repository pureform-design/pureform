      "--components-timePicker-focusIndicatorOuterOffset": "token(sizes.focusIndicatorOuterOffset)",
      "--components-timePicker-focusIndicatorThickness": "token(sizes.focusIndicatorThickness)",
      "--components-timePicker-stateDraggedOpacity": "token(opacity.stateDragged)",
      "--components-timePicker-stateFocusOpacity": "token(opacity.stateFocus)",
      "--components-timePicker-stateHoverOpacity": "token(opacity.stateHover)",
      "--components-timePicker-statePressedOpacity": "token(opacity.statePressed)",
      "alignItems": "stretch",
      "backgroundColor": "var(--components-timePicker-container, token(colors.surfaceContainerHigh))",
      "borderRadius": "var(--components-timePicker-radius, token(radii.extraLarge))",
      "color": "var(--components-timePicker-fieldContent, token(colors.onSurface))",
      "display": "flex",
      "flexDirection": "column",
      "gap": "var(--components-timePicker-gap, token(spacing.5))",
      "paddingBlockEnd": "var(--components-timePicker-padding, token(spacing.6))",
      "paddingBlockStart": "var(--components-timePicker-padding, token(spacing.6))",
      "paddingInlineEnd": "var(--components-timePicker-padding, token(spacing.6))",
      "paddingInlineStart": "var(--components-timePicker-padding, token(spacing.6))",
      "shadowElevation": "level3",
      "transition": "background-color token(durations.short3) token(easings.standard), color token(durations.short3) token(easings.standard), border-color token(durations.short3) token(easings.standard), outline-color token(durations.short3) token(easings.standard), box-shadow token(durations.medium1) token(easings.standard)",
    },
    "scrollItem": {
      "&:is([aria-selected=true], [aria-pressed=true], [aria-current]:not([aria-current=false]))": {
        "backgroundColor": "var(--components-timePicker-fieldSelectedContainer, token(colors.primaryContainer))",
        "color": "var(--components-timePicker-fieldSelectedContent, token(colors.onPrimaryContainer))",
      },
      "alignItems": "center",
      "borderRadius": "var(--components-timePicker-fieldRadius, token(radii.small))",
      "color": "var(--components-timePicker-periodContent, token(colors.onSurfaceVariant))",
      "cursor": "pointer",
      "display": "flex",
      "flexShrink": "0",
      "height": "var(--components-timePicker-scrollItemHeight, 56px)",
      "justifyContent": "center",
      "textStyle": "displayMedium",
    },
    "separator": {
      "alignItems": "center",
      "color": "var(--components-timePicker-separatorColor, token(colors.onSurface))",
      "display": "flex",
      "justifyContent": "center",
      "textStyle": "displayLarge",
      "width": "var(--components-timePicker-separatorWidth, 24px)",
    },
  },
  "className": "timePicker",
  "compoundVariants": [],
  "defaultVariants": {
    "color": "standard",
    "mode": "dial",
  },
  "jsx": [
    "TimePicker",
  ],
  "slots": [
    "root",
    "headline",
    "body",
    "hourSelector",
    "separator",
    "minuteSelector",
    "scrollItem",
    "periodSelector",
    "period",
    "dial",
    "dialTrack",
    "dialHandle",
    "dialCenter",
    "dialLabel",
    "actions",
  ],
  "variants": {
    "color": {
      "standard": {},
      "vibrant": {
        "root": {
          "--components-timePicker-container": "token(colors.primaryContainer)",
          "--components-timePicker-dialContainer": "token(colors.surfaceContainerLowest)",
          "--components-timePicker-fieldContainer": "token(colors.surfaceContainerLowest)",
          "--components-timePicker-fieldSelectedContainer": "token(colors.primary)",
          "--components-timePicker-fieldSelectedContent": "token(colors.onPrimary)",
          "--components-timePicker-headlineColor": "token(colors.onPrimaryContainer)",
          "--components-timePicker-periodContent": "token(colors.onPrimaryContainer)",
          "--components-timePicker-periodOutlineColor": "token(colors.onPrimaryContainer)",
          "--components-timePicker-separatorColor": "token(colors.onPrimaryContainer)",
        },
      },
    },
    "mode": {
      "dial": {},
      "scroll": {
        "dial": {
          "display": "none",
        },
        "hourSelector": {
          "backgroundColor": {
            "&:focus-visible": "color-mix(in srgb, transparent, var(--components-timePicker-fieldContent, token(colors.onSurface)) var(--components-timePicker-stateFocusOpacity, token(opacity.stateFocus)))",
            "&:is(:active, [data-pf-active])": "color-mix(in srgb, transparent, var(--components-timePicker-fieldContent, token(colors.onSurface)) var(--components-timePicker-statePressedOpacity, token(opacity.statePressed)))",
            "&:is(:hover, [data-pf-hover])": "color-mix(in srgb, transparent, var(--components-timePicker-fieldContent, token(colors.onSurface)) var(--components-timePicker-stateHoverOpacity, token(opacity.stateHover)))",
            "&[data-pf-dragging][data-pf-dragging]": "color-mix(in srgb, transparent, var(--components-timePicker-fieldContent, token(colors.onSurface)) var(--components-timePicker-stateDraggedOpacity, token(opacity.stateDragged)))",
            "base": "transparent",
          },
          "flexDirection": "column",
          "gap": "var(--components-timePicker-scrollGap, token(spacing.1))",
          "height": "calc(var(--components-timePicker-scrollItemHeight, 56px) * 3)",
          "overflow": "hidden",
        },
        "minuteSelector": {
          "backgroundColor": {
            "&:focus-visible": "color-mix(in srgb, transparent, var(--components-timePicker-fieldContent, token(colors.onSurface)) var(--components-timePicker-stateFocusOpacity, token(opacity.stateFocus)))",
            "&:is(:active, [data-pf-active])": "color-mix(in srgb, transparent, var(--components-timePicker-fieldContent, token(colors.onSurface)) var(--components-timePicker-statePressedOpacity, token(opacity.statePressed)))",
            "&:is(:hover, [data-pf-hover])": "color-mix(in srgb, transparent, var(--components-timePicker-fieldContent, token(colors.onSurface)) var(--components-timePicker-stateHoverOpacity, token(opacity.stateHover)))",
            "&[data-pf-dragging][data-pf-dragging]": "color-mix(in srgb, transparent, var(--components-timePicker-fieldContent, token(colors.onSurface)) var(--components-timePicker-stateDraggedOpacity, token(opacity.stateDragged)))",
            "base": "transparent",
          },
          "flexDirection": "column",
          "gap": "var(--components-timePicker-scrollGap, token(spacing.1))",
          "height": "calc(var(--components-timePicker-scrollItemHeight, 56px) * 3)",
          "overflow": "hidden",
        },
      },
    },
  },
}
`;
