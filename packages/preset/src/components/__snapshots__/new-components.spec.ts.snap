exports[`dialog > compiles to a stable Panda slot recipe 1`] = `
{
  "base": {
    "actions": {
      "display": "flex",
      "flexDirection": "row",
      "gap": "var(--components-dialog-actionsGap, token(spacing.2))",
      "justifyContent": "end",
      "marginBlockStart": "token(spacing.2)",
    },
    "body": {
      "color": "var(--components-dialog-bodyColor, token(colors.onSurfaceVariant))",
      "textStyle": "bodyMedium",
    },
    "headline": {
      "color": "var(--components-dialog-headlineColor, token(colors.onSurface))",
      "textStyle": "headlineSmall",
    },
    "icon": {
      "_rtl": {
        "&[data-pf-mirror]": {
          "transform": "scaleX(-1)",
        },
      },
      "alignItems": "center",
      "color": "var(--components-dialog-iconColor, token(colors.secondary))",
      "display": "inline-flex",
      "fontSize": "var(--components-dialog-iconSize, token(sizes.iconMedium))",
      "fontVariationSettings": ""FILL" var(--components-dialog-iconFill, 0)",
      "height": "var(--components-dialog-iconSize, token(sizes.iconMedium))",
      "justifyContent": "center",
      "lineHeight": "1",
      "minWidth": "var(--components-dialog-iconSize, token(sizes.iconMedium))",
      "width": "var(--components-dialog-iconSize, token(sizes.iconMedium))",
    },
    "root": {
      "&[data-state=closed]": {
        "animation": {
          "_motionReduce": "token(springs.effectsFast.duration) token(springs.effectsFast.easing) forwards overlayFadeOut",
          "base": "token(springs.effectsFast.duration) token(springs.effectsFast.easing) forwards dialogSlideOut, token(springs.effectsFast.duration) token(springs.effectsFast.easing) forwards overlayFadeOut",
        },
      },
      "&[data-state=open]": {
        "animation": {
          "_motionReduce": "token(springs.effectsFast.duration) token(springs.effectsFast.easing) overlayFadeIn",
          "base": "token(springs.spatialDefault.duration) token(springs.spatialDefault.easing) dialogSlideIn, token(springs.effectsFast.duration) token(springs.effectsFast.easing) overlayFadeIn",
        },
      },
      "backgroundColor": "var(--components-dialog-container, token(colors.surfaceContainerHigh))",
      "borderRadius": "var(--components-dialog-radius, token(radii.extraLarge))",
      "borderWidth": "0px",
      "color": "var(--components-dialog-bodyColor, token(colors.onSurfaceVariant))",
      "display": "flex",
      "flexDirection": "column",
      "gap": "var(--components-dialog-gap, token(spacing.4))",
      "maxWidth": "var(--components-dialog-maxWidth, 560px)",
      "minWidth": "var(--components-dialog-minWidth, 280px)",
      "paddingBlockEnd": "var(--components-dialog-padding, token(spacing.6))",
      "paddingBlockStart": "var(--components-dialog-padding, token(spacing.6))",
      "paddingInlineEnd": "var(--components-dialog-padding, token(spacing.6))",
      "paddingInlineStart": "var(--components-dialog-padding, token(spacing.6))",
      "shadowElevation": "level3",
      "zIndex": "token(zIndex.dialog)",
    },
  },
  "className": "dialog",
  "compoundVariants": [],
  "defaultVariants": {
    "icon": false,
  },
  "jsx": [
    "Dialog",
  ],
  "slots": [
    "root",
    "icon",
    "headline",
    "body",
    "actions",
  ],
  "variants": {
    "icon": {
      "false": {},
      "true": {
        "headline": {
          "textAlign": "center",
        },
        "icon": {
          "marginInlineEnd": "auto",
          "marginInlineStart": "auto",
        },
      },
    },
  },
}
`;

