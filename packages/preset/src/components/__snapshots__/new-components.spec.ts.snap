          "&:is([aria-selected=true], [aria-pressed=true], [data-selected])": {
            "backgroundColor": {
              "&[data-dragging][data-dragging]": "color-mix(in srgb, var(--components-tabs-container, token(colors.surface)), var(--components-tabs-secondaryActiveColor, token(colors.onSurface)) token(opacity.stateDragged))",
              "_active": "color-mix(in srgb, var(--components-tabs-container, token(colors.surface)), var(--components-tabs-secondaryActiveColor, token(colors.onSurface)) token(opacity.statePressed))",
              "_focusVisible": "color-mix(in srgb, var(--components-tabs-container, token(colors.surface)), var(--components-tabs-secondaryActiveColor, token(colors.onSurface)) token(opacity.stateFocus))",
              "_hover": "color-mix(in srgb, var(--components-tabs-container, token(colors.surface)), var(--components-tabs-secondaryActiveColor, token(colors.onSurface)) token(opacity.stateHover))",
              "base": "var(--components-tabs-container, token(colors.surface))",
            },
            "color": "var(--components-tabs-secondaryActiveColor, token(colors.onSurface))",
          },
          "backgroundColor": {
            "&[data-dragging][data-dragging]": "color-mix(in srgb, var(--components-tabs-container, token(colors.surface)), var(--components-tabs-content, token(colors.onSurfaceVariant)) token(opacity.stateDragged))",
            "_active": "color-mix(in srgb, var(--components-tabs-container, token(colors.surface)), var(--components-tabs-content, token(colors.onSurfaceVariant)) token(opacity.statePressed))",
            "_focusVisible": "color-mix(in srgb, var(--components-tabs-container, token(colors.surface)), var(--components-tabs-content, token(colors.onSurfaceVariant)) token(opacity.stateFocus))",
            "_hover": "color-mix(in srgb, var(--components-tabs-container, token(colors.surface)), var(--components-tabs-content, token(colors.onSurfaceVariant)) token(opacity.stateHover))",
            "base": "var(--components-tabs-container, token(colors.surface))",
          },
          "color": "var(--components-tabs-content, token(colors.onSurfaceVariant))",
        },
      },
    },
  },
}
`;
