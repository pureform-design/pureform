        "&:is(:active, [data-pf-active])": "color-mix(in srgb, transparent, var(--components-snackbar-content, token(colors.inverseOnSurface)) var(--components-snackbar-statePressedOpacity, token(opacity.statePressed)))",
        "&:is(:hover, [data-pf-hover])": "color-mix(in srgb, transparent, var(--components-snackbar-content, token(colors.inverseOnSurface)) var(--components-snackbar-stateHoverOpacity, token(opacity.stateHover)))",
        "&[data-pf-dragging][data-pf-dragging]": "color-mix(in srgb, transparent, var(--components-snackbar-content, token(colors.inverseOnSurface)) var(--components-snackbar-stateDraggedOpacity, token(opacity.stateDragged)))",
        "base": "transparent",
