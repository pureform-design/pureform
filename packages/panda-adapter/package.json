{
    "name": "@pureform/panda-adapter",
    "version": "0.0.0-semantically-released",
    "description": "Compiles a pureform CoreConfig to a Panda CSS preset (Layer 2)",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            }
        }
    },
    "dependencies": {
        "@pureform/core": "workspace:^"
    },
    "devDependencies": {
        "@pandacss/types": "catalog:",
        "@pureform/tsconfig": "catalog:",
        "@pureform/vite-config": "catalog:",
        "@pureform/vitest-config": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@pandacss/dev": "catalog:"
    }
}
