{
    "name": "@pureform/core",
    "version": "0.0.0-semantically-released",
    "description": "Agnostic styling AST and config contract (Layer 1)",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            }
        },
        "./ast": {
            "types": "./dist/ast/index.d.ts",
            "import": {
                "development": "./src/ast/index.ts",
                "default": "./dist/ast.mjs"
            },
            "require": {
                "development": "./src/ast/index.ts",
                "default": "./dist/ast.mjs"
            }
        },
        "./raw": {
            "types": "./dist/raw.d.ts",
            "import": {
                "development": "./src/raw.ts",
                "default": "./dist/raw.mjs"
            },
            "require": {
                "development": "./src/raw.ts",
                "default": "./dist/raw.mjs"
            }
        },
        "./ast/raw": {
            "types": "./dist/ast/raw.d.ts",
            "import": {
                "development": "./src/ast/raw.ts",
                "default": "./dist/ast/raw.mjs"
            },
            "require": {
                "development": "./src/ast/raw.ts",
                "default": "./dist/ast/raw.mjs"
            }
        },
        "./ast/helpers": {
            "types": "./dist/ast/helpers/index.d.ts",
            "import": {
                "development": "./src/ast/helpers/index.ts",
                "default": "./dist/ast/helpers.mjs"
            },
            "require": {
                "development": "./src/ast/helpers/index.ts",
                "default": "./dist/ast/helpers.mjs"
            }
        },
        "./ast/helpers/keyword": {
            "types": "./dist/ast/helpers/keyword/index.d.ts",
            "import": {
                "development": "./src/ast/helpers/keyword/index.ts",
                "default": "./dist/ast/helpers/keyword.mjs"
            },
            "require": {
                "development": "./src/ast/helpers/keyword/index.ts",
                "default": "./dist/ast/helpers/keyword.mjs"
            }
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": {
                "development": "./src/types.ts",
                "default": "./dist/types.mjs"
            },
            "require": {
                "development": "./src/types.ts",
                "default": "./dist/types.mjs"
            }
        },
        "./fixtures/button": {
            "types": "./src/__fixtures__/button.ts",
            "development": "./src/__fixtures__/button.ts",
            "default": "./src/__fixtures__/button.ts"
        },
        "./ast/helpers/*": {
            "types": "./dist/ast/helpers/*.d.ts",
            "import": {
                "development": "./src/ast/helpers/*.ts",
                "default": "./dist/ast/helpers/*.mjs"
            },
            "require": {
                "development": "./src/ast/helpers/*.ts",
                "default": "./dist/ast/helpers/*.mjs"
            }
        }
    },
    "dependencies": {},
    "devDependencies": {
        "@pureform/tsconfig": "workspace:^",
        "@pureform/type-utils": "workspace:^",
        "@pureform/vite-config": "workspace:^",
        "@pureform/vitest-config": "workspace:^",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
