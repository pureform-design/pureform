{
    "name": "@pureform/cli",
    "version": "0.0.0-semantically-released",
    "description": "The pureform command: pureform generate writes the generated registry to .pureform/ without a bundler, watches it, and checks a committed one",
    "bin": {
        "pureform": "./dist/pureform.mjs"
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "development": "./src/index.ts",
                "default": "./dist/index.mjs"
            }
        }
    },
    "dependencies": {
        "@pureform/generate": "catalog:",
        "jiti": "catalog:"
    },
    "devDependencies": {
        "@pureform/tsconfig": "catalog:",
        "@pureform/vite-config": "catalog:",
        "@pureform/vitest-config": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
