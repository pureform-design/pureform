{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "../..",
        "noEmit": true,
        "jsx": "preserve",
        "jsxImportSource": "@solidjs/web",
        "types": ["vite/client", "node", "@vitest/browser-playwright"],
        "paths": {
            "@/*": ["./src/*"],
            "$*": ["../panda-fixture/styled-system/*"],
            "#*": ["../panda-fixture/src/*"]
        }
    },
    "include": ["src", "../panda-fixture/.pureform/**/*.*"]
}
