{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "../..",
        "noEmit": true,
        "jsx": "preserve",
        "jsxImportSource": "@solidjs/web",
        "types": ["vite/client", "node", "@vitest/browser-playwright"],
        "paths": {
            "@/*": ["./src/*"],
            "#binding": ["./src/bindings/solid/harness.tsx"],
            "#registry": ["./src/targets/panda/registry.ts"]
        }
    },
    "include": ["src", ".pureform/**/*.*", "../panda-fixture/.pureform/**/*.*"]
}
